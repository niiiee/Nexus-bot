# ====================================================================
# SENIOR PROGG DISCORD BOT & COMMUNITY ARCHITECT - ENVIRONMENT CONFIG
# ====================================================================

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Telegram Companion Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BACKUP_CHANNEL_ID=your_telegram_channel_or_group_id_here

# Central AI Brain Providers (gemini | openai | anthropic | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration (SQLite file path or PostgreSQL URL)
DATABASE_URL=data/senior_progg.db

# Web Dashboard & API Server
PORT=3000
SESSION_SECRET=super_secure_random_session_secret_change_in_production
DASHBOARD_URL=http://localhost:3000

# Security & Sandboxing
SANDBOX_TIMEOUT_MS=5000
MAX_CODE_MEMORY_MB=128
ENABLE_ANTI_RAID=true

# Environment
NODE_ENV=development
LOG_LEVEL=info
