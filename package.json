{
  "name": "senior-progg-bot",
  "version": "1.0.0",
  "description": "Production-grade, fully AI-driven Discord server-management bot for freelancer community with Telegram companion and Web Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "qa-gate": "tsx scripts/run-qa-gate.ts",
    "dry-run": "tsx scripts/dry-run-simulation.ts"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "grammy": "^1.34.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
